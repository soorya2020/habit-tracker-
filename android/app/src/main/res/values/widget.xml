<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_surface">#F7F6F2</color>
    <color name="widget_ink">#1A1A18</color>
    <color name="widget_muted">#6E6D68</color>
    <string name="widget_description">Today\'s habits. Tap one to log it.</string>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
